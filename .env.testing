; Test environment — read by PHPUnit via tests/TestCase.php.
; Tests run against a SEPARATE database (blogs_test) so they never touch
; development data. The test bootstrap drops + rebuilds it from migrations.

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=blogs_test
DB_USERNAME=youssef
DB_PASSWORD=1234

; Test-only JWT settings (never reuse these outside tests)
JWT_SECRET=test-secret-not-for-production-0123456789abcdef
JWT_TTL=3600
JWT_ISSUER=first-api-test

; Admin seeded into the test database by the users migration
ADMIN_NAME="Test Admin"
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=admin12345
