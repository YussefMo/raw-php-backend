; Copy this file to .env and fill in your own values.

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=blogs
DB_USERNAME=root
DB_PASSWORD=

; Generate a fresh secret with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me
JWT_TTL=3600
JWT_ISSUER=first-api

; Seeded by the users migration so you can test admin-only routes immediately
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
