{
  "name": "youssef/my-api",
  "description": "Raw PHP REST API",
  "type": "project",
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^7.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "scripts": {
    "dev": "php -S localhost:8000 -t public public/index.php",
    "migrate": "php database/migrate.php migrate",
    "migrate:fresh": "php database/migrate.php fresh"
  }
}
